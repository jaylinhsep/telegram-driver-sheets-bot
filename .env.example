# -------------------------------------------------------------
# TELEGRAM BOT CONFIGURATION
# -------------------------------------------------------------
# Lấy token từ @BotFather trên Telegram:
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# -------------------------------------------------------------
# GOOGLE SPREADSHEET CONFIGURATION
# -------------------------------------------------------------
# ID Google Sheet (lấy từ link sheet giữa /d/ và /edit):
GOOGLE_SHEET_ID=13ndQsSmBsKlHjIRQR0S0MO5BPqqL6J4CECBAYfQi1oo

# Tên tab chứa danh sách xe & lái xe (mặc định gid=1046738475 là DanhSachXe):
GOOGLE_SHEET_TAB_DATA=DanhSachXe

# Tên tab chứa danh sách master Vendor (mặc định gid=331541216 là VENDOR):
GOOGLE_SHEET_TAB_VENDOR=VENDOR

# -------------------------------------------------------------
# GOOGLE SERVICE ACCOUNT CREDENTIALS
# -------------------------------------------------------------
# Dán toàn bộ nội dung file JSON của Google Service Account vào đây:
# (Hoặc nếu chạy local, đặt file tên 'service_account.json' vào cùng thư mục bot)
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}

# -------------------------------------------------------------
# RENDER.COM & WEBHOOK (Tùy chọn)
# -------------------------------------------------------------
PORT=8000
# Trên Render, RENDER_EXTERNAL_URL sẽ tự động có dạng https://ten-app.onrender.com
# Hoặc để trống để bot tự chạy chế độ Polling trong nền
WEBHOOK_URL=

# -------------------------------------------------------------
# BẢO MẬT & PHÂN QUYỀN (Tùy chọn)
# -------------------------------------------------------------
# Danh sách Telegram User ID hoặc Group Chat ID được phép dùng bot (ngăn người lạ):
# Để trống nếu cho phép tất cả mọi người sử dụng.
# Ví dụ: ALLOWED_CHAT_IDS=123456789,987654321
ALLOWED_CHAT_IDS=

# Thời gian lưu cache dữ liệu (giây) để bot phản hồi siêu nhanh và không bị giới hạn Google API:
CACHE_TTL=60
